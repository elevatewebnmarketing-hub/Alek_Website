{
  "name": "runway-refined-monorepo",
  "private": true,
  "workspaces": [
    "frontend",
    "admin",
    "backend"
  ],
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.60.1",
    "lightningcss-linux-x64-gnu": "1.32.0"
  },
  "scripts": {
    "dev": "npm run dev -w frontend",
    "dev:frontend": "npm run dev -w frontend",
    "dev:admin": "npm run dev -w admin",
    "dev:backend": "npm run dev -w backend",
    "build": "npm run build -w frontend && npm run build -w admin",
    "lint": "npm run lint -w frontend --if-present && npm run lint -w admin --if-present && npm run lint -w backend --if-present",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend"
  }
}
