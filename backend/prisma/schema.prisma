generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime queries go through the connection pooler (Supabase Supavisor, port 6543).
  url       = env("DATABASE_URL")
  // Migrations / introspection need a direct connection (Supabase, port 5432).
  directUrl = env("DIRECT_URL")
}

enum LeadSource {
  contact
  resources
  booking
  other
}

enum JournalStatus {
  draft
  published
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
}

/**
 * Scopes a booking before checkout: one-time item vs full package (in full or instalments).
 * Gateway charges are a later step; this row is a Calendly-first record.
 */
enum BookingPaymentScope {
  one_time_item
  full_package_full
  full_package_instalments
}

model BookingIntent {
  id             String            @id @default(cuid())
  packageSlug    String
  paymentScope   BookingPaymentScope
  contactEmail   String?
  notes          String?           @db.Text
  /** Optional denormalized snapshot (for reporting when frontend pricing changes) */
  pricingSnapshot Json?
  createdAt      DateTime          @default(now())

  @@index([packageSlug, createdAt])
  @@index([createdAt])
}

model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String
  message   String?    @db.Text
  source    LeadSource @default(contact)
  createdAt DateTime   @default(now())
  utmSource String?
  utmMedium String?
  utmCampaign String?

  @@index([createdAt])
  @@index([source])
}

model PortfolioProject {
  id          String   @id @default(cuid())
  slug        String   @unique
  eyebrow     String
  title       String
  intro       String   @db.Text
  body        String   @db.Text
  heroImage   String?
  content     Json     // { imageSlides: [], videoSlides: [] }
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, sortOrder])
}

model JournalPost {
  id          String        @id @default(cuid())
  slug        String        @unique
  category    String
  title       String
  excerpt     String        @db.Text
  body        String        @db.Text
  coverImage  String?
  status      JournalStatus @default(draft)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([publishedAt])
}

model ResourceItem {
  id          String   @id @default(cuid())
  type        String
  title       String
  description String   @db.Text
  linkUrl     String?
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, sortOrder])
}

model Testimonial {
  id          String   @id @default(cuid())
  quote       String   @db.Text
  name        String
  role        String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, sortOrder])
}

model PaymentRecord {
  id              String        @id @default(cuid())
  stripePaymentId String?       @unique
  stripeSessionId String?       @unique
  amountCents     Int
  currency        String        @default("gbp")
  status          PaymentStatus @default(pending)
  customerEmail   String?
  description     String?
  createdAt       DateTime      @default(now())
  metadata        Json?

  @@index([createdAt])
  @@index([status])
}
